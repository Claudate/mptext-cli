{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mptext",
  "version": "0.2.1",
  "identifier": "top.mptext.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "mptext — 公众号文章下载",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "mptext 公众号文章下载桌面版",
    "longDescription": "搜索公众号、浏览文章列表、批量下载 Markdown/HTML 格式文章。",
    "category": "Utility",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
